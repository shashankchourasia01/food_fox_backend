# ===========================================
# SARASWATI TIFFIN - Backend Environment
# Copy this file to .env and fill in your values
# ===========================================

# MongoDB
MONGO_URI=mongodb://localhost:27017/food_fox

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=30d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS, redirects)
FRONTEND_URL=http://localhost:5173

# ===========================================
# OTP - EMAIL (FREE - Recommended)
# ===========================================
# Gmail: Use App Password from https://myaccount.google.com/apppasswords
# Outlook: smtp.office365.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Saraswati Tiffin <your_email@gmail.com>

# ===========================================
# OTP - SMS (Costs ~₹0.25-0.35 per OTP)
# ===========================================
FAST2SMS_API_KEY=your_fast2sms_api_key

# DLT Route - For consistent "Saraswati Tiffin" sender (optional)
# Requires DLT registration - see DLT_SETUP_GUIDE.md
FAST2SMS_SENDER_ID=SRSTFN
FAST2SMS_DLT_TEMPLATE_ID=your_approved_template_id

# ===========================================
# Razorpay
# ===========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# Delivery area (optional)
# ===========================================
RESTAURANT_LAT=12.9716
RESTAURANT_LNG=77.5946
MAX_DELIVERY_KM=10
